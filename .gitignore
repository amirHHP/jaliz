# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]

# Local npm metadata (never commit)
.npm/

# Accidental cache-like paths under the repo root
Library/

# Editor / backup artifacts
*.bak

# Local run logs
dev.log

# SQLite local database and journal files
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal

# Android TWA build artifacts
/android/app/
/android/build/
/android/gradle/
/android/.gradle/
/android/gradlew
/android/gradlew.bat
/android/settings.gradle
/android/build.gradle
/android/local.properties
*.jks
*.keystore
*.aab
*.apk

# Generated changelog (auto-built from git history)
/public/changelog.json
