{
  "name": "jaliz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:py\"",
    "dev:next": "prisma generate && next dev",
    "dev:py": "cd api && ../.venv/bin/uvicorn index:app --reload --port 8000",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "build": "prisma generate && node scripts/generate-changelog.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate-otp": "node scripts/migrate-otp-auth.mjs",
    "db:migrate-subscription": "node scripts/migrate-subscription.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@next/third-parties": "^16.2.10",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.5.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "uvicorn": "^0.0.1-security",
    "vitest": "^4.1.5"
  }
}
