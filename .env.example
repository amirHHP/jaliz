# Gemini AI API Key (Fallback if not set in Admin UI)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather API Key for local weather forecasts
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database URL (Used by Prisma)
DATABASE_URL=file:./prisma/dev.db

# HTTP Proxy for API container (optional)
HTTP_PROXY=

# ZarinPal Merchant ID
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id_here
